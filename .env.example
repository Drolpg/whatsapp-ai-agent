# Copie este arquivo para .env e preencha com os valores reais.
# O .env nao vai pro git (ver .gitignore).
#
# As variaveis do Ollama ja sao usadas pelo adapter da Fase 3; as do Twilio
# ficam documentadas aqui porque entram nas Fases 5 e 6.

# --- Twilio: canal WhatsApp via Agent Connect (Fase 5) e handoff (Fase 6) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_CONVERSATION_CONFIGURATION_ID=

# --- LLM local: Ollama (Fase 3) e embeddings do RAG (Fase 4) ---
OLLAMA_BASE_URL=http://localhost:11434
# Modelo usado pra gerar as respostas. Precisa estar baixado no Ollama
# (`ollama pull <modelo>`); veja os disponiveis com `ollama list`.
# Atencao ao tamanho: com qwen2.5:0.5b o modelo ignorou as instrucoes em
# todos os cenarios testados e inventou respostas. O llama3.2:3b foi
# verificado e e o minimo recomendado.
OLLAMA_MODEL=llama3.2:3b

# Modelo de embeddings usado pelo RAG (Fase 4). Tambem servido pelo Ollama,
# entao precisa de `ollama pull nomic-embed-text`. Trocar de modelo muda a
# escala das distancias: reconstrua o indice e recalibre o
# DISTANCIA_MAXIMA_PADRAO em adapters/knowledge/faiss_repository.py.
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text
